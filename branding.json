{
  "theme": "diyaa's-website",
  "colors": {
    "primary": "#B19CD9",
    "secondary": "#FFB3BA",
    "accent": "#BAFFC9",
    "highlight": "#FFFFBA",
    "background": "#F5F5F5",
    "backgroundDark": "#E8E8E8",
    "text": "#2D2D2D",
    "textLight": "#5A5A5A",
    "border": "#D4A5F7",
    "success": "#A8E6CF",
    "warning": "#FFD3A5",
    "error": "#FFAAA5"
  },
  "fonts": {
    "heading": "'Orbitron', 'Arial Black', sans-serif",
    "body": "'Inter', 'Segoe UI', sans-serif",
    "mono": "'Fira Code', 'Courier New', monospace"
  },
  "spacing": {
    "xs": "0.5rem",
    "sm": "1rem",
    "md": "1.5rem",
    "lg": "2rem",
    "xl": "3rem",
    "xxl": "4rem"
  },
  "borderRadius": {
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px"
  },
  "shadows": {
    "sm": "0 2px 4px rgba(177, 156, 217, 0.1)",
    "md": "0 4px 8px rgba(177, 156, 217, 0.15)",
    "lg": "0 8px 16px rgba(177, 156, 217, 0.2)",
    "glow": "0 0 20px rgba(177, 156, 217, 0.3)"
  },
  "animations": {
    "duration": "0.3s",
    "easing": "cubic-bezier(0.4, 0, 0.2, 1)"
  }
}

